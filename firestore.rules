rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // twins/{twinId} — a twin's own profile. Private to the owning device.
    // Other twins' name/photo reach the client only via the denormalized
    // copy negotiateTwins.ts snapshots into matches/{matchId}.names and
    // .photoUrls at negotiation time — the app never reads another twin's
    // profile directly, so there's no reason this needs to be world-
    // readable to every signed-in user.
    match /twins/{twinId} {
      allow read, write: if request.auth != null && request.auth.uid == twinId;
    }

    // context_submissions/{twinId} — audit trail of what a twin's context
    // was actually built from: the raw pasted text dump, plus any scraped
    // Instagram/Facebook text from Tier B (see CLAUDE.md's two-tier
    // context model). Private to the owning device; the submitContext and
    // importSocialContext Cloud Functions write via the Admin SDK (which
    // bypasses these rules), so this really only governs any direct
    // client reads/writes.
    match /context_submissions/{twinId} {
      allow read, write: if request.auth != null && request.auth.uid == twinId;
    }

    // ble_sessions/{token} — maps a short random BLE-advertised session
    // token (see BleProximityService.kt) back to the real twinId that
    // generated it. Needed because a legacy BLE advertisement packet caps
    // at 31 bytes total, nowhere near enough to fit a 28-byte Firebase
    // uid alongside the mandatory flags + service-data-UUID overhead — so
    // the phone advertises a short random token and any scanning device
    // resolves it here instead.
    match /ble_sessions/{token} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.data.twinId == request.auth.uid;
    }

    // checkins/{locationId}/people/{twinId} — "I'm here" presence docs.
    // Any signed-in device may read who's checked in; a device may only
    // create/update/delete its own check-in entry.
    match /checkins/{locationId}/people/{twinId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == twinId;
    }

    // matches/{matchId} — negotiation transcript + outcome for a pair of
    // twins, including the loser's real name/photo for a dismissed match.
    // Readable ONLY by the two twins involved — a real name someone's
    // twin evaluated and passed on should never be visible to a third
    // party. The judge dashboard does NOT read this collection; it reads
    // judge_feed/ below, a deliberately redacted copy. All writes happen
    // server-side (negotiateTwins / onCheckin via the Admin SDK, which
    // bypasses rules) — clients never write matches directly.
    match /matches/{matchId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.twinIds;
      allow write: if false;
    }

    // judge_feed/{matchId} — the public-safe copy of a negotiation for the
    // judge-facing dashboard (which signs in anonymously — see
    // judge-dashboard/index.html). Readable by any signed-in user, unlike
    // matches/ above: negotiateTwins.ts only ever writes full real data
    // here for a CONFIRMED match; a dismissed one gets just the outcome
    // (status + score), no names/photos/reason/transcript, since those
    // tend to name-drop real people in the model's own words.
    match /judge_feed/{matchId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
