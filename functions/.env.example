# Copy to functions/.env.local (NOT .env) for local emulator use
# (firebase emulators:start reads it automatically). Deployed environments
# never read this file — they use the Cloud Functions v2 secret instead:
#
#   firebase functions:secrets:set META_MODEL_API_KEY
#
# Must be .env.local specifically: plain `.env`/`.env.<project-id>` files
# get uploaded as real environment variables on deploy, and a plain env var
# named the same as a declared secret makes the deploy fail. See
# functions/README.md for details.

# Meta Model API key ("Muse Spark"). The base URL (https://api.meta.ai) and
# model id (muse-spark-1.3) are hardcoded in functions/src/lib/metaModel.ts
# per Meta's confirmed docs — Model API speaks the Anthropic Messages API
# shape natively, so the official @anthropic-ai/sdk is pointed at Meta's
# endpoint instead of a custom HTTP client.
META_MODEL_API_KEY=...
