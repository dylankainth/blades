# Copy to functions/.env for local emulator use (firebase emulators:start
# reads functions/.env automatically). In deployed environments this is NOT
# read from .env — set it as a Cloud Functions v2 secret instead:
#
#   firebase functions:secrets:set META_MODEL_API_KEY
#
# See functions/README.md for details.

# Meta Model API key ("Muse Spark"). The base URL (https://api.meta.ai) and
# model id (muse-spark-1.3) are hardcoded in functions/src/lib/metaModel.ts
# per Meta's confirmed docs — Model API speaks the Anthropic Messages API
# shape natively, so the official @anthropic-ai/sdk is pointed at Meta's
# endpoint instead of a custom HTTP client.
META_MODEL_API_KEY=...
